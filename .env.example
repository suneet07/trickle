# =============================================================================
# Trickle configuration. Copy to .env and fill in, or run:
#   node scripts/init-env.mjs
# which generates the secrets for you.
# =============================================================================

# ---------- App ----------
# Public URL people (and Google) use to reach the app. Used for OAuth redirects
# and unsubscribe/tracking links, so it must be the real external address.
APP_BASE_URL=http://localhost:8080
# Set to false if the app is exposed directly with no reverse proxy in front.
TRUST_PROXY=true

# ---------- Database / Redis ----------
# Used when running with pnpm. Docker Compose overrides these with its own
# bundled services, so you can leave them as-is there.
DATABASE_URL=postgresql://trickle:trickle@localhost:5432/trickle?schema=public
REDIS_URL=redis://localhost:6379
# Password for the bundled Postgres container (Docker Compose only).
POSTGRES_PASSWORD=trickle

# ---------- Secrets (required) — generate each with: openssl rand -hex 32 ----------
# Signs session cookies. Rotating it signs everyone out.
SESSION_SECRET=
# Signs unsubscribe and tracking links. Never rotate it after you start sending,
# or links in emails already delivered stop working.
TRACKING_SECRET=
# 64 hex chars. Encrypts Gmail OAuth tokens at rest (AES-256-GCM). If you lose
# it, every inbox must be reconnected.
TOKEN_ENCRYPTION_KEY=

# ---------- Sign-in (configure at least one) ----------
# Google sign-in for these addresses. Comma-separated; "@company.com" allows a
# whole domain. Requires the Google OAuth client below.
ALLOWED_LOGIN_EMAILS=
# Or a single shared admin password (12+ characters).
ADMIN_PASSWORD=

# ---------- Google OAuth (needed to connect Gmail inboxes) ----------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type "Web application"). Add BOTH redirect URIs to the client:
#   ${APP_BASE_URL}/api/accounts/oauth/callback
#   ${APP_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only set these if the redirect URIs differ from the defaults above.
# GOOGLE_REDIRECT_URI=
# GOOGLE_LOGIN_REDIRECT_URI=

# ---------- Sending ----------
# false = dry-run: the whole pipeline runs and records sends, but nothing is
# emailed. Flip to true once inboxes are connected and you've checked a dry run.
SEND_LIVE=false
# Ceiling on cold emails per day across ALL inboxes.
GLOBAL_DAILY_CAP=100
# Safe total per inbox per day, warmup + cold combined.
PER_INBOX_TOTAL_CAP=40
# Holidays to skip when planning: "us" (US federal) or "none".
HOLIDAY_CALENDAR=us
# Timezone for leads with no timezone column, region or US state.
DEFAULT_TIMEZONE=America/Los_Angeles

# ---------- Default sender footer ----------
# Appended as a signature block to emails using the default footer. Leave all
# blank for no footer. Many jurisdictions (e.g. CAN-SPAM in the US) require a
# physical postal address in commercial email.
SENDER_NAME=
SENDER_TITLE=
SENDER_COMPANY=
SENDER_POSTAL_ADDRESS=

# ---------- Automation (optional) ----------
# Static bearer token for scripts: Authorization: Bearer <API_TOKEN>.
# Empty disables token auth.
API_TOKEN=

# ---------- Alerts (optional) ----------
# none | email | telegram | webhook. Alerts always appear in the activity log.
ALERT_CHANNEL=none
# email: sent from your first connected inbox to this address.
ALERT_EMAIL=
# telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# webhook: Slack / Discord incoming webhook, or any URL accepting a JSON POST.
ALERT_WEBHOOK_URL=

# ---------- HTTPS with the bundled Caddy (docker compose --profile https) ----------
# DOMAIN=trickle.example.com
